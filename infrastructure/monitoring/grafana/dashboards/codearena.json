{
  "title": "CodeArena execution infrastructure",
  "uid": "codearena",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "API requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(codearena_api_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 2,
      "title": "API p95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le)(rate(codearena_api_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 3,
      "title": "Queued submissions",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "codearena_queue_depth",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 4,
      "title": "Worker active slots",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "codearena_worker_active",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 5,
      "title": "Execution p95 duration",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(codearena_execution_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 6,
      "title": "API failures",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(codearena_api_requests_total{status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    }
  ]
}
