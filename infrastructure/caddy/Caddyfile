:80 {
  # Metrics are scraped on the private control network, never through public ingress.
  # "respond" takes precedence over the catch-all web handler.
  @private_metrics path /metrics /metrics/*
  respond @private_metrics 404

  @api path /v1/* /health*
  handle @api {
    reverse_proxy api:4000 {
      flush_interval -1
    }
  }
  handle {
    reverse_proxy web:3000
  }
  header X-Content-Type-Options nosniff
}
