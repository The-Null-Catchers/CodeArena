{
  "name": "codearena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "concurrently \"tsx watch apps/api/src/index.ts\" \"tsx watch apps/scheduler/src/index.ts\" \"tsx watch apps/worker/src/index.ts\" \"pnpm --dir apps/web dev\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && corepack pnpm --dir apps/web typecheck",
    "build": "tsc && corepack pnpm --dir apps/web build && corepack pnpm --dir packages/execution-sdk build",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "runtimes:build": "bash infrastructure/scripts/build-runtimes.sh",
    "format": "prettier --write .",
    "test:fleet": "vitest run --config vitest.fleet.config.ts",
    "test:redis": "vitest run --config vitest.redis.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.53.0",
    "dockerode": "^4.0.6",
    "fastify": "^5.3.0",
    "ioredis": "^5.6.0",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "tar-stream": "^3.1.7",
    "zod": "^3.24.0",
    "ipaddr.js": "^2.2.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.52.0",
    "@types/dockerode": "^3.3.38",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/tar-stream": "^3.1.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.26.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.0",
    "@types/nodemailer": "^6.4.17",
    "prettier": "^3.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "protobufjs"
    ]
  }
}
