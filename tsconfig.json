{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "apps/scheduler/**/*.ts",
    "apps/delivery-worker/**/*.ts",
    "apps/maintenance-worker/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": ["packages/execution-sdk", "node_modules", "dist"]
}
